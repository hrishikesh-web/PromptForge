# Copy to server/.env and fill in. Never commit server/.env.

# Server
PORT=5000
NODE_ENV=development

# MySQL 8 connection (your local MySQL account)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=promptforge_db
# Set to true only if your MySQL server requires SSL (e.g. a cloud database)
DB_SSL=false

# Login tokens: use a long random string (at least 16 characters)
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Local demonstration mode: lists the demo accounts (names + emails only) on the sign-in page.
# Ignored when NODE_ENV=production.
DEMO_MODE=false
# Optional: the password `npm run demo:passwords` gives every demo account (min 10 characters).
# Leave empty to have the script generate one and print it once.
DEMO_USER_PASSWORD=

# Optional, only for `npm run test:live`
LIVE_ADMIN_EMAIL=
LIVE_ADMIN_PASSWORD=
